# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Streamlit secrets (prevent accidental credential leaks)
.streamlit/secrets.toml

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Temporary files, caches, and upload buffers
*.tmp
*.tmp.*
lecture_upload.tmp
*.log
*.bak

# Audio test recordings / uploads
*.wav
*.mp3
*.m4a
*.flac
*.ogg

# Large model weights / checkpoints (downloaded at runtime by faster-whisper / Param-1)
*.bin
*.pt
*.pth
*.onnx
*.safetensors
models/
.cache/

